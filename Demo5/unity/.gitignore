# Unity (based on github/gitignore Unity.gitignore). Paths are relative to this Unity project.

# Local native build scratch files.
/.utmp/

# Generated by Unity: rebuilt from Assets/, Packages/ and ProjectSettings/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools, never needed in the repo
/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE files Unity regenerates (csproj/sln) and IDE state
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and system info
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Builds (APKs for the Quest, Android app bundles)
*.apk
*.aab
*.unitypackage
*.app

# Gradle files Unity regenerates for Android builds
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/gradleTemplate.properties.meta
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/gradle-wrapper.properties

# Test runner scene
InitTestScene*.unity*

# Addressables default build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
