  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &241108019
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 241108018}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 47ceeedfcc5afc5b98a9d5df780e9b19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Freestyle.Battle.DJHost
  battle: {fileID: 945999724}
  dj: {fileID: 340454916}
  decks: {fileID: 1385712145}
  micRest: {fileID: 1236052109}
  crowd: {fileID: 1858606033}
  crowdAudio: {fileID: 1858606035}
  introduce: 1
  countIn: 1
  cheerTime: 2.6
  pause: 0.25
  nameTimeout: 6
  announceWinner: 1
  resultPause: 1.5
  roar: 2
  greetings:
  - id: greet_1
    text: What's good, everybody! Welcome to battle night! It's DJ Crossfade on the
      decks, and you already know how we do it in here!
    clip: {fileID: 8300000, guid: 9d49424e522c5fe328d662d21d1da3e8, type: 3}
    cues: {fileID: 4900000, guid: 869b636a939824ec190e2c401be8ac7f, type: 3}
  - id: greet_2
    text: Make some noise! It's battle night, and tonight somebody's going home humbled!
    clip: {fileID: 8300000, guid: d6bd4b619a89ac8a2873e39b9f735b79, type: 3}
    cues: {fileID: 4900000, guid: 39e187e43991c0edda73a50ce62c6b89, type: 3}
  - id: greet_3
    text: Yo, yo, yo! Can I get some energy in here? Welcome out to battle night!
    clip: {fileID: 8300000, guid: 37fb7bdda852e2fccbba690e698a8b65, type: 3}
    cues: {fileID: 4900000, guid: 1d9fa672542299bd39897539f7f736da, type: 3}
  mcIntros:
  - id: mc_big_poopy_pants
    text: Uh... somebody wandered in from the birthday party next door. Give it up
      for... Poop McPants!
    clip: {fileID: 8300000, guid: 61713091b50e4b050abed3aef5974cec, type: 3}
    cues: {fileID: 4900000, guid: a7f4bf797623d602f9ac164ba620ec45, type: 3}
  - id: mc_lil_nervous
    text: 'In this corner: first battle ever, so be nice... or don''t! Lil Nervous!'
    clip: {fileID: 8300000, guid: dcd71fec243c93ced961240515b8ac4a, type: 3}
    cues: {fileID: 4900000, guid: 90fbaf3cc1da2873797bd715f2395e8d, type: 3}
  - id: mc_mc_static
    text: 'In this corner: five years running the Thursday cypher, a legend in their
      own mind... MC Static!'
    clip: {fileID: 8300000, guid: b7a3ed8275b2e485cace8ef794211d1b, type: 3}
    cues: {fileID: 4900000, guid: fda661a63cce6874fb5bc224e16f741f, type: 3}
  - id: mc_loose_cannon
    text: Security, stay close. Banned from two leagues and back for more... Loose
      Cannon!
    clip: {fileID: 8300000, guid: 9f9ca1618667e0e52be6cd6e77b238aa, type: 3}
    cues: {fileID: 4900000, guid: 0159091e3b97193c2a96723849ae7437, type: 3}
  - id: mc_kid_venom
    text: 'In this corner: undefeated this season, and the homework''s already done
      on you... Kid Venom!'
    clip: {fileID: 8300000, guid: ee2ae1cece6ebbb2eb57035e86f7aead, type: 3}
    cues: {fileID: 4900000, guid: 63c7e7fcabbef3836b36e5d330bedb0d, type: 3}
  - id: mc_the_champ
    text: Everybody on your feet. Twelve-time champion, battle rap royalty... The
      Champ!
    clip: {fileID: 8300000, guid: 4479ae70687b95584ab478799f87b7c6, type: 3}
    cues: {fileID: 4900000, guid: aebe5086e21683149a86d897b0e77f04, type: 3}
  - id: mc_any
    text: 'In this corner: tonight''s house MC! Give it up!'
    clip: {fileID: 8300000, guid: 2786f3abcae2456119ceaf34821d6c6d, type: 3}
    cues: {fileID: 4900000, guid: d94639edf0ee7b31c8b532f4a9c4dcff, type: 3}
  challengers:
  - id: ch_1
    text: And their challenger tonight, put your hands together for...
    clip: {fileID: 8300000, guid: d7024597a0fc83779bf89a12882455e5, type: 3}
    cues: {fileID: 4900000, guid: 786888bffda74bdad916fcd2e8a3756c, type: 3}
  - id: ch_2
    text: And stepping up to the mic, the challenger! Make some noise for...
    clip: {fileID: 8300000, guid: 7e4dc1efc4cf5919683bcaf6bd8983fc, type: 3}
    cues: {fileID: 4900000, guid: 7f6dad689b91b2732aa849a5ab2c12ea, type: 3}
  - id: ch_3
    text: And in the other corner, straight out of the dressing room, it's...
    clip: {fileID: 8300000, guid: 7927e31e3230ca99ca06aae37b768ef3, type: 3}
    cues: {fileID: 4900000, guid: 736db97d41722d9eba988e3edcb2d18e, type: 3}
  unnamed:
  - id: anon_1
    text: And in the other corner, a brand new face! Show the challenger some love!
    clip: {fileID: 8300000, guid: 07d2fd762996efc2e8ebc2705e78f304, type: 3}
    cues: {fileID: 4900000, guid: 8347a580b3afbb498ab60a823657ffcb, type: 3}
  - id: anon_2
    text: And their challenger, stepping up for the very first time! Make some noise!
    clip: {fileID: 8300000, guid: 5f6acada0a9872a618df71f37051bd33, type: 3}
    cues: {fileID: 4900000, guid: f36951ed696c87109b4d6c36b477a7fd, type: 3}
  begins:
  - id: go_1
    text: Alright, alright! Let's get it on!
    clip: {fileID: 8300000, guid: 46bfc898965b03d9096bc1c1287b97b0, type: 3}
    cues: {fileID: 4900000, guid: bd05897ebcfa6d1a2ada0c481a877bca, type: 3}
  - id: go_2
    text: Let's begin! Run that beat!
    clip: {fileID: 8300000, guid: d2105e62f35f241c4a7a9c34399a98c1, type: 3}
    cues: {fileID: 4900000, guid: 25a30c5ee70434df0b3c0140791a312c, type: 3}
  - id: go_3
    text: Okay! Here we go!
    clip: {fileID: 8300000, guid: 9965460dfa04912aa9aee1d3dedf4145, type: 3}
    cues: {fileID: 4900000, guid: 64f2b62193bc654c096aaaac7ab4e3b9, type: 3}
  count:
  - id: count_4
    text: Four!
    clip: {fileID: 8300000, guid: f645749880ba053c6b59891e1029fc45, type: 3}
    cues: {fileID: 4900000, guid: f484e263cf352c8589c0c824db11f6dc, type: 3}
  - id: count_3
    text: Three!
    clip: {fileID: 8300000, guid: 1f78e7d79e7dd308cb0e555bd4116efb, type: 3}
    cues: {fileID: 4900000, guid: 7caa931d651543f58aa388475867d016, type: 3}
  - id: count_2
    text: Two!
    clip: {fileID: 8300000, guid: 3d2f5f674d2c5902faf88ef6e62a3880, type: 3}
    cues: {fileID: 4900000, guid: d6bc4a241d08032d29be868005cae621, type: 3}
  - id: count_1
    text: One!
    clip: {fileID: 8300000, guid: 8b1f8886faf39f956b34b900552fe8d6, type: 3}
    cues: {fileID: 4900000, guid: 710005d258bac14daac1cd9b9b10575c, type: 3}
  winLeads:
  - id: win_lead_1
    text: Alright, alright, settle down! The crowd has spoken... and your winner
      is...
    clip: {fileID: 8300000, guid: b29fdaa6e29a49eada3d59a0faf6f7b7, type: 3}
    cues: {fileID: 4900000, guid: b4be08850f02af51b92113c267698253, type: 3}
  - id: win_lead_2
    text: Okay, okay! What a battle! Your winner tonight...
    clip: {fileID: 8300000, guid: 6c7d95adda922daedb559db17b66cba7, type: 3}
    cues: {fileID: 4900000, guid: a45ae1e7e7ea8c571931461d54c16e15, type: 3}
  - id: win_lead_3
    text: Make some noise one more time! And the winner is...
    clip: {fileID: 8300000, guid: ab55a0845cabe300aa7cd07b4ccca4b1, type: 3}
    cues: {fileID: 4900000, guid: 1c96f4e64eabba511917e04c9be3e1d5, type: 3}
  mcWins:
  - id: win_mc_big_poopy_pants
    text: Poop McPants?! Somebody call the birthday party!
    clip: {fileID: 8300000, guid: 3b07443595fa10005bec97c9caf9761e, type: 3}
    cues: {fileID: 4900000, guid: 9c0321be14bcc4539adcb82c7399aa92, type: 3}
  - id: win_mc_lil_nervous
    text: Lil Nervous! First battle ever, and the nerves held up!
    clip: {fileID: 8300000, guid: 2aa44a476c396cb90b95bf4a4f8f6333, type: 3}
    cues: {fileID: 4900000, guid: 8fa8d05baaa08df2593789cf4bf472da, type: 3}
  - id: win_mc_mc_static
    text: MC Static! The Thursday cypher legend lives on!
    clip: {fileID: 8300000, guid: e5427a4009adafb9cbeaa34f061b7fae, type: 3}
    cues: {fileID: 4900000, guid: b54d210866c01a79b901d27094a91021, type: 3}
  - id: win_mc_loose_cannon
    text: Loose Cannon! Somebody check on the challenger!
    clip: {fileID: 8300000, guid: 556da8fd354f6002b9aca46c44393a90, type: 3}
    cues: {fileID: 4900000, guid: a6551956db2a66ac8905a24b13fef503, type: 3}
  - id: win_mc_kid_venom
    text: Kid Venom! Still undefeated!
    clip: {fileID: 8300000, guid: a4559173a29860eaba7bc26bfb533484, type: 3}
    cues: {fileID: 4900000, guid: bdaa6d19fd4a0ac9899dafec495adb31, type: 3}
  - id: win_mc_the_champ
    text: Still the champ... The Champ!
    clip: {fileID: 8300000, guid: d3fb5644d0c2b2abfa7cfc52a53dcd3b, type: 3}
    cues: {fileID: 4900000, guid: 4bdff47d7939c2a90a7844bb95d5f6ce, type: 3}
  - id: win_mc_any
    text: The house MC! Holding it down!
    clip: {fileID: 8300000, guid: 0f7014edc8604be71b8b1fa790ecabd3, type: 3}
    cues: {fileID: 4900000, guid: 29de7f10bf79ae4fb98250d231de4606, type: 3}
  challengerWins:
  - id: win_you_1
    text: The challenger! What an upset!
    clip: {fileID: 8300000, guid: 10616f5aad3749493868f149e71800b5, type: 3}
    cues: {fileID: 4900000, guid: b4e092ad74a118937a45c226bfd1f373, type: 3}
  - id: win_you_2
    text: The new face! Straight out of the dressing room and straight to the top!
    clip: {fileID: 8300000, guid: cf2a86e9168a9949aa91f8bf18810f86, type: 3}
    cues: {fileID: 4900000, guid: 102d35e42b27e69728acf2118e2bb7e4, type: 3}
  draws:
  - id: draw_1
    text: Hold up... it's a tie! Too close to call! Give it up for both of them!
    clip: {fileID: 8300000, guid: 79c68f6f1064a7faf975012e74e193d7, type: 3}
    cues: {fileID: 4900000, guid: f74b6b5b6afd62f6293bdb0a97b2de6f, type: 3}
  - id: draw_2
    text: I can't split them! It's a draw! Make some noise for both of these MCs!
    clip: {fileID: 8300000, guid: 656b28a2c571d852692726a2ae1df876, type: 3}
    cues: {fileID: 4900000, guid: 3a950984ef457a53ab15b6556b6b510e, type: 3}
  paVolume: 1
  directVolume: 0.35
  onMcIntroduced:
    m_PersistentCalls:
      m_Calls: []
  onPlayerIntroduced:
    m_PersistentCalls:
      m_Calls: []
  onBegin:
    m_PersistentCalls:
      m_Calls: []
  onWinnerAnnounced:
    m_PersistentCalls:
      m_Calls: []
