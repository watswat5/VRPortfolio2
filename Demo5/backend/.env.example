# Copy to backend/.env and fill in. Real environment variables override this file.
OPENROUTER_API_KEY=sk-or-...

# Password for the whole server (browser: a login page; headset/tools: Authorization: Bearer <password>).
# Leave it out to run open, e.g. on localhost. Set it before exposing the server (tunnel, port forward).
# FREESTYLE_PASSWORD=

# Optional overrides
# OPPONENT_MODEL=google/gemini-3.1-flash-lite   # or anthropic/claude-haiku-5.5 (cheaper, ~3.6 s)
# RATER=auto            # jev | heuristic  (auto = jev when a key is set)
# VOICE=auto            # qwen | openrouter | indextts | breeze | none  (openrouter: hosted, no GPU)
# TTS_MODEL=elevenlabs/eleven-v3   # VOICE=openrouter; or fish-audio/drama-3 (add fish voice IDs to voices.toml)
# TRANSCRIBER=whisper   # whisper (local) | deepgram (hosted, streaming, no GPU) | openrouter (hosted, no GPU)
# DEEPGRAM_API_KEY=     # TRANSCRIBER=deepgram (falls back to openrouter if Deepgram can't be reached)
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_KEYTERMS=1   # boost the word drops and the MC's name (~25% on top of Deepgram's base price)
# STT_MODEL=openai/whisper-large-v3-turbo   # TRANSCRIBER=openrouter  (auto = qwen when a GPU is available; breeze: ./setup_breeze.sh, ./run_breeze.sh)
# BREEZE_URL=http://127.0.0.1:7860
# INDEXTTS_URL=http://127.0.0.1:7861
# BREEZE_CFG=4.0        # how strongly Breeze follows the delivery directions
# QWEN_TTS_SPEAKER=Ryan # or Aiden
# WHISPER_MODEL=small.en
# LOW_VRAM=auto         # 1 = int8 Whisper, Qwen 4 lines at a time, free GPU cache (auto: on below 10 GB VRAM)
# QWEN_DTYPE=auto       # bfloat16 | float16 (auto: float16 on GPUs without bfloat16, e.g. RTX 20xx)
